# ==================== REQUIRED ====================
# Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ==================== OPTIONAL ====================
# Environment (development/production)
ENVIRONMENT=development

# Whisper Model Size (tiny, base, small, medium, large)
# 'base' is recommended for balance of speed and accuracy on CPU.
WHISPER_MODEL=base

# ==================== SMTP SETTINGS (FUTURE EMAIL SUPPORT) ====================
# SMTP server settings to wire up real caregiver alerts via email later
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=sender_email@gmail.com
ALERT_TO_EMAIL=caregiver_email@gmail.com
